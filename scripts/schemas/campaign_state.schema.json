{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gsamuele78/RumblingStone/scripts/schemas/campaign_state.schema.json",
  "title": "Stato di campagna RumblingStone — fatti verificabili",
  "description": "Contratto di campaign/state.yaml (ADR-0017). Il vincolo centrale: nessun fatto è esprimibile senza dichiarare a quale TEMPO appartiene — giocato al tavolo, oppure preparato come design. È la regola che, se fosse esistita, avrebbe reso impossibile il finding C1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confine", "archi", "party", "artefatti", "inferred"],
  "properties": {
    "schema_version": { "const": 1 },

    "confine": {
      "description": "Dove passa la linea fra giocato e preparato. È l'unica fonte di questa informazione: i banner di state.md la citano, non la definiscono.",
      "type": "object",
      "additionalProperties": false,
      "required": ["giocato_fino_a", "prossima_scena", "da_giocare", "aggiornato"],
      "properties": {
        "giocato_fino_a": { "type": "string", "minLength": 3 },
        "prossima_scena": { "type": "string", "minLength": 3 },
        "da_giocare": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "aggiornato": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },

    "archi": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arco", "tempo", "stato"],
        "properties": {
          "arco": { "type": "string", "minLength": 2 },
          "tempo": {
            "description": "OBBLIGATORIO. Non esiste un arco senza tempo dichiarato.",
            "enum": ["giocato", "in_corso", "preparato"]
          },
          "stato": { "type": "string", "minLength": 2 },
          "march_clock": { "type": ["string", "null"] },
          "pg_livello": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },

    "party": {
      "description": "I quattro PG. `oggi` e `preparato` sono chiavi separate: un agente non può scrivere una posizione senza dire in quale tempo vale.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pg", "classe", "oggi"],
        "properties": {
          "pg": { "type": "string", "minLength": 2 },
          "classe": { "type": "string", "minLength": 2 },
          "oggi": {
            "description": "OBBLIGATORIO: lo stato reale al tavolo. È la colonna che si usa in sessione.",
            "type": "string",
            "minLength": 3
          },
          "preparato": {
            "description": "Facoltativo: lo stato scritto in avanti. null se non diverge da `oggi`.",
            "type": ["string", "null"]
          },
          "filoni": { "type": ["string", "null"] }
        }
      }
    },

    "artefatti": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artefatto", "portatore", "oggi"],
        "properties": {
          "artefatto": { "type": "string", "minLength": 2 },
          "portatore": { "type": "string", "minLength": 1 },
          "oggi": { "type": "string", "minLength": 3 },
          "preparato": { "type": ["string", "null"] }
        }
      }
    },

    "inferred": {
      "description": "Le incertezze come RECORD, non come stringa da cercare col grep. Ogni voce porta la domanda da fare al DM: è ciò che rende smaltibile il debito invece che solo contabilizzabile.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dove", "domanda", "a_chi", "aperto_dal"],
        "properties": {
          "id": { "type": "string", "pattern": "^INF-\\d{3}$" },
          "dove": { "type": "string", "minLength": 3 },
          "domanda": {
            "description": "Formulata come domanda vera, rispondibile dal DM senza rileggere i file.",
            "type": "string",
            "minLength": 15
          },
          "a_chi": { "enum": ["DM", "giocatori", "tavolo"] },
          "aperto_dal": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "fonte": { "type": ["string", "null"] }
        }
      }
    }
  }
}
